# Dependencies
node_modules/

# Build outputs
dist/
.next/
next-env.d.ts
out/
.turbo/

# Test
coverage/

# Environment. Every .env variant stays local; only the example is shared.
.env*
!.env.example

# Editor and OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Misc
*.tsbuildinfo
.vercel

# Fumadocs generated source
.source/

# Maintainer-only helper that seeds labels and issues. It is never committed;
# everything else under scripts/ is tracked.
/scripts/create-issues.sh

# Governance: worktrees for every branch, and ship-*.sh scripts prepared for
# the maintainer at the repository root. scripts/*.sh is not affected.
.worktrees/
/*.sh

# Python bytecode from scripts/security
__pycache__/
