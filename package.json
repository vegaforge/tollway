{
  "name": "tollway",
  "version": "0.0.0",
  "private": true,
  "description": "Orchestration, policy, and observability layer for agent payments on Stellar (x402 + MPP)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/vegaforge/tollway.git"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "build": "turbo run build",
    "api-extractor": "api-extractor",
    "attw": "attw",
    "test": "turbo run test",
    "bench": "turbo run build --filter=@vegaforge/tollway-bench^... && pnpm --filter @vegaforge/tollway-bench bench",
    "typecheck": "turbo run typecheck",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "preflight": "./scripts/preflight.sh",
    "publint": "publint",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish",
    "knip": "knip --include dependencies,unlisted,binaries,unresolved"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "2.4.16",
    "@changesets/cli": "^2.31.1",
    "@microsoft/api-extractor": "^7.60.1",
    "@types/mdast": "^4.0.4",
    "knip": "6.41.0",
    "lefthook": "^2.2.2",
    "mdast": "^3.0.0",
    "publint": "^0.3.25",
    "remark": "^15.0.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "tsx": "^4.23.15",
    "turbo": "^2.11.13",
    "typescript": "^5.9.3",
    "unist-util-visit": "^5.2.0",
    "vite": "^7.3.8"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.10": ">=8.5.10",
      "axios@<1.20.0": "^1.20.0",
      "toml@<5.0.1": "^5.0.1",
      "vite@>=7.0.0 <7.3.7": "^7.3.8",
      "esbuild@>=0.27.3 <0.28.1": "^0.28.2"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "@stellar/mpp>@stellar/stellar-sdk": "16"
      }
    }
  }
}
