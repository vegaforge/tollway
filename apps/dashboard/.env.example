# Dashboard sign-in. See docs/dashboard-data-contracts.md, "Dashboard security".
# At least 32 bytes, for example: openssl rand -base64 48
DASHBOARD_SESSION_SECRET=replace-with-at-least-32-random-bytes
# credentials is the default and the only provider today.
DASHBOARD_AUTH_PROVIDER=credentials
# bcrypt hashes of cost 10 or more; roles are viewer or admin. Replace the placeholder hash.
DASHBOARD_USERS=[{"username":"admin","passwordHash":"$2b$12$replace.with.a.real.bcrypt.hash.of.53.characters.","role":"admin"}]
# The public origin when the dashboard runs behind a reverse proxy.
# DASHBOARD_ORIGIN=https://dashboard.example.com
# A header the proxy sets (not appends) to the client address, for per-client throttling.
# DASHBOARD_CLIENT_IP_HEADER=x-real-ip
