{
  "name": "@vegaforge/tollway-web",
  "version": "0.0.0",
  "private": true,
  "description": "Tollway landing page and documentation",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "node init && next dev",
    "predev": "pnpm run api && fumadocs-mdx",
    "build": "node init && next build",
    "prebuild": "pnpm run api && fumadocs-mdx",
    "start": "node init && next start",
    "api": "typedoc && node typedoc/check-api.mjs",
    "postinstall": "fumadocs-mdx",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@stellar/stellar-base": "15.0.0",
    "@vegaforge/tollway-core": "workspace:*",
    "@vegaforge/tollway-theme": "workspace:*",
    "@x402/core": "^2.31.0",
    "fumadocs-core": "^16.19.4",
    "fumadocs-mdx": "^13.0.8",
    "fumadocs-ui": "^16.19.4",
    "next": "^16.4.6",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vegaforge/tollway-server": "workspace:*",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.3.5",
    "typedoc": "0.28.20",
    "typedoc-plugin-frontmatter": "1.3.3",
    "typedoc-plugin-markdown": "4.14.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
