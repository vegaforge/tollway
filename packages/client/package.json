{
  "name": "@vegaforge/tollway-client",
  "version": "0.0.1",
  "description": "Agent-side client that routes, pays, and collects receipts across settlement models",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/vegaforge/tollway.git",
    "directory": "packages/client"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./sqlite": {
      "types": "./dist/sqlite-store.d.ts",
      "import": "./dist/sqlite-store.js",
      "require": "./dist/sqlite-store.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vegaforge/tollway-core": "workspace:*",
    "@x402/core": "^2.31.0",
    "@x402/stellar": "^2.31.0"
  },
  "devDependencies": {
    "@stellar/stellar-sdk": "16.4.1",
    "@types/node": "^22.20.5",
    "fast-check": "^3.23.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "publishConfig": {
    "access": "public"
  }
}
