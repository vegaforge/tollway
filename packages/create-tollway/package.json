{
  "name": "create-tollway",
  "version": "0.1.0",
  "description": "Scaffold a paid Tollway API with Express, Hono, or Next.js",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/vegaforge/tollway.git",
    "directory": "packages/create-tollway"
  },
  "type": "module",
  "bin": {
    "create-tollway": "./dist/cli.js"
  },
