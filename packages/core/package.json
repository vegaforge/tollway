{
  "name": "@vegaforge/tollway-core",
  "version": "0.0.1",
  "description": "Shared types, the canonical signed receipt, and the model router interface for Tollway",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/vegaforge/tollway.git",
    "directory": "packages/core"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./policy-loader": {
      "import": {
        "types": "./dist/policy-loader.d.ts",
        "default": "./dist/policy-loader.js"
      },
      "require": {
        "types": "./dist/policy-loader.d.cts",
        "default": "./dist/policy-loader.cjs"
      }
    },
    "./schema/policy.schema.json": "./schema/policy.schema.json"
  },
  "files": [
    "dist",
    "schema"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "mutation": "stryker run --incremental --force",
    "mutation:incremental": "stryker run --incremental"
  },
  "dependencies": {
    "@x402/core": "^2.31.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/node": "^22.20.5",
    "fast-check": "^4.10.3",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "publishConfig": {
    "access": "public"
  }
}
