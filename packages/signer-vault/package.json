{
  "name": "@vegaforge/tollway-signer-vault",
  "version": "0.0.1",
  "description": "A Tollway ReceiptSigner backed by a HashiCorp Vault Transit Ed25519 key",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/vegaforge/tollway.git",
    "directory": "packages/signer-vault"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vegaforge/tollway-core": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "publishConfig": {
    "access": "public"
  }
}
