{
  "name": "@vegaforge/tollway-server",
  "version": "0.0.1",
  "description": "Service-side payment gate, the framework-agnostic core that charges agents",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/vegaforge/tollway.git",
    "directory": "packages/server"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "mutation": "stryker run --incremental --force",
    "mutation:incremental": "stryker run --incremental",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@stellar/mpp": "0.7.1",
    "@stellar/stellar-sdk": "16.4.1",
    "@vegaforge/tollway-core": "workspace:*",
    "@x402/core": "^2.31.0",
    "@x402/extensions": "~2.31.0",
    "@x402/stellar": "^2.31.0",
    "mppx": "0.8.19",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/ioredis-mock": "^8.2.8",
    "@types/node": "^22.20.5",
    "fast-check": "^4.10.3",
    "ioredis-mock": "^8.13.1",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "publishConfig": {
    "access": "public"
  }
}
