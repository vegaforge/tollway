# Copy to .env.local for local runs. Never commit a filled-in copy.
# Every variable is described in README.md, "Environment variables".

# mock (default, no secrets) or testnet.
TOLLWAY_MODE=mock

# true on a hosted deployment. Requires TOLLWAY_RECEIPT_KEY and REDIS_URL.
TOLLWAY_DEPLOYED=false

# base64url Ed25519 private key (PKCS#8 or 32-byte seed). Required unless
# TOLLWAY_MODE=mock and TOLLWAY_DEPLOYED=false. See README.md, "Receipt key".
TOLLWAY_RECEIPT_KEY=
# Optional. Defaults to the base64url public key.
TOLLWAY_RECEIPT_KEY_ID=

# Redis for the shared settlement cache. Required when TOLLWAY_DEPLOYED=true.
REDIS_URL=

# testnet only: OpenZeppelin Channels API key, from
# https://channels.openzeppelin.com/testnet/gen
OZ_API_KEY=
# Optional override of the facilitator URL.
FACILITATOR_URL=

# Optional. The account that receives payments (G...) and the USDC contract (C...).
TOLLWAY_PAY_TO=
TOLLWAY_ASSET=
